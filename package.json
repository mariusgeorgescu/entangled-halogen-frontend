{
    "name": "entangled-frontend",
    "version": "0.2.0",
    "type": "module",
    "engines": {
        "node": "v23.10.0"
    },
    "dependencies": {
        "@emurgo/cardano-serialization-lib-browser": "^11.5.0",
        "@fastify/cors": "^10.0.1",
        "@fastify/http-proxy": "^11.1.1",
        "@fastify/static": "^8.0.1",
        "@tailwindcss/vite": "^4.1.10",
        "fastify": "^5.1.0",
        "http-server": "^14.1.1",
        "postcss-cli": "^11.0.1",
        "purescript": "^0.15.15",
        "purs-tidy": "^0.11.0",
        "purty": "^7.0.0",
        "spago": "^0.93.29",
        "vite": "^6.2.0",
        "vite-plugin-top-level-await": "^1.4.1",
        "vite-plugin-wasm": "^3.3.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.10",
        "autoprefixer": "^10.4.21",
        "copyfiles": "^2.4.1",
        "daisyui": "^5.5.5",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.1.10"
    },
    "scripts": {
        "build:spago": "spago bundle --bundle-type module --platform browser --outfile public/index.js",
        "build:css": "postcss src/style.css -o ./public/output.css",
        "copy-images": "copyfiles -u 1 images/*.svg dist/images/ && copyfiles -u 1 'images/**/*' dist/images/",
        "copy-public": "copyfiles -u 1 public/* dist/",
        "build": "npm run build:spago && npm run build:css && npx vite build && npm run copy-images && npm run copy-public",
        "dev": "npm run build && npx vite dev",
        "serve": "npm run build && npx vite serve ",
        "start": "http-server ./dist -p $PORT",
        "bff": "npm run build && node bff/server.js",
        "bff:dev": "node --watch bff/server.js",
        "deploy-dev": "docker buildx build --platform linux/amd64,linux/arm64 --provenance=false -t mariusgeorgescu/entangled-frontend:dev -f Dockerfile . --push",
        "deploy-prod": "docker buildx build --platform linux/amd64,linux/arm64 --provenance=false -t mariusgeorgescu/entangled-frontend:prod -f Dockerfile . --push"
    },
    "browser": {
        "child_process": false
    }
}